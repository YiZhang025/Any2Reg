+                    prelogits_vol = np.vstack(prelogits_list).transpose((1, 0, 2, 3))
+            if return_encoder_features and len(enc_features_list) > 0:
+                enc_vols = {}
+                # collect keys
+                first_non_empty = None
+                for d in enc_features_list:
+                    if isinstance(d, dict) and len(d) > 0:
+                        first_non_empty = d
+                        break
+                if first_non_empty is not None:
+                    for key in sorted(first_non_empty.keys()):
+                        stage_slices = []
+                        for d in enc_features_list:
+                            stage_slices.append(d[key][None])
+                        if reduce_feature_maps:
+                            # d[key] is (H, W) -> stack -> (Z, H, W)
+                            enc_vols[key] = np.vstack(stage_slices)  # (Z, H, W)
+                            enc_vols[key] = enc_vols[key].transpose((1, 0, 2))  # (H, Z, W)
+                            enc_vols[key] = enc_vols[key].transpose((1, 0, 2))  # (Z, H, W)
+                        else:
+                            enc_vols[key] = np.vstack(stage_slices).transpose((1, 0, 2, 3))
+            if return_prelogits and return_encoder_features:
+                return predicted_segmentation, softmax_pred, prelogits_vol, enc_vols
+            if return_prelogits:
+                return predicted_segmentation, softmax_pred, prelogits_vol
+            return predicted_segmentation, softmax_pred, enc_vols
         return predicted_segmentation, softmax_pred
 
 
