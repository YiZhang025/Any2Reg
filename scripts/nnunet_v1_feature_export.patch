+    def extract_and_save_features(self, data: np.ndarray, out_npz: str,
+                                  use_sliding_window: bool = True, step_size: float = 0.5,
+                                  save_dtype=np.float16, compress: bool = True, verbose: bool = False,
+                                  return_encoder_features: bool = True,
+                                  reduce_feature_maps: bool = False, feature_reduce_mode: str = 'l2',
+                                  properties: dict = None) -> None:
+        """
+        Runs inference to extract intermediate features (prelogits and optionally encoder features) and saves them.
+        Supports 2D networks and pseudo-3D inference for 2D convs. 3D conv networks are not supported here.
+        :param data: preprocessed network input (shape (C, H, W) for 2D or (C, X, Y, Z) for 3D volumes)
+        :param out_npz: output .npz path
+        """
+        assert isinstance(self.network, (SegmentationNetwork, nn.DataParallel))
+
+        # choose mirroring consistent with training
+        do_mirroring = bool(self.data_aug_params.get("do_mirror", True))
+        if do_mirroring:
+            mirror_axes = tuple(self.data_aug_params.get("mirror_axes", (0, 1)))
+        else:
+            mirror_axes = ()
+
+        # enforce eval mode (and disable deep supervision for inference if present)
+        current_mode = self.network.training
+        ds_attr_present = hasattr(self.network, "do_ds")
+        ds_prev = None
+        if ds_attr_present:
+            ds_prev = self.network.do_ds
+            self.network.do_ds = False
+        self.network.eval()
+
+        try:
+            # only 2D conv path is supported for feature extraction (hooks implemented there)
+            is_2d_conv = (self.network.conv_op == nn.Conv2d) or isinstance(self.network.conv_op, type) and (self.network.conv_op is nn.Conv2d)
+            if not is_2d_conv:
+                print("WARNING: extract_and_save_features currently supports only Conv2d-based networks. Skipping.")
+                return
+
+            # decide which tiled function to call based on input dimensionality
+            use_gaussian = True
+            pad_border_mode = self.inference_pad_border_mode
+            pad_kwargs = self.inference_pad_kwargs
+            all_in_gpu = False
+
+            ret = None
+            if use_sliding_window:
+                if data.ndim == 3:
+                    # (C, H, W)
+                    ret = self.network._internal_predict_2D_2Dconv_tiled(
+                        data, step_size, do_mirroring, mirror_axes, self.patch_size, self.regions_class_order,
+                        use_gaussian, pad_border_mode, pad_kwargs, all_in_gpu, verbose,
+                        return_prelogits=True, return_encoder_features=return_encoder_features,
+                        reduce_feature_maps=reduce_feature_maps, feature_reduce_mode=feature_reduce_mode
+                    )
+                elif data.ndim == 4:
+                    # (C, X, Y, Z) -> pseudo-3D with 2D convs
+                    ret = self.network._internal_predict_3D_2Dconv_tiled(
+                        data, self.patch_size, do_mirroring, mirror_axes, step_size, self.regions_class_order,
+                        use_gaussian, pad_border_mode, pad_kwargs, all_in_gpu, verbose,
+                        return_prelogits=True, return_encoder_features=return_encoder_features,
+                        reduce_feature_maps=reduce_feature_maps, feature_reduce_mode=feature_reduce_mode
+                    )
+                else:
+                    raise RuntimeError("Unexpected data ndim. Expected 3 (C,H,W) or 4 (C,X,Y,Z).")
+            else:
+                # non-sliding not supported for features, keep behavior explicit
+                raise NotImplementedError("extract_and_save_features requires use_sliding_window=True")
+
+            # parse returns (vary depending on flags and availability)
+            prelogits = None
+            enc_feats = None
+            if isinstance(ret, tuple):
+                if len(ret) == 4:
+                    _, _, prelogits, enc_feats = ret
+                elif len(ret) == 3:
+                    # could be (seg, softmax, prelogits) or (seg, softmax, enc_feats)
+                    third = ret[2]
+                    if isinstance(third, dict):
+                        enc_feats = third
+                    else:
+                        prelogits = third
+                # else ignore (segmentation/softmax only)
+
+            # build npz payload
+            to_save = {}
+            def _to_numpy(x, target_dtype=None):
+                if isinstance(x, np.ndarray):
+                    if target_dtype is not None and x.dtype != target_dtype:
+                        return x.astype(target_dtype, copy=False)
+                    return x
+                if torch.is_tensor(x):
+                    t = x.detach()
+                    if target_dtype is not None:
+                        # convert on GPU/CPU once, then transfer
+                        try:
+                            # if tensor on CUDA, convert dtype there to reduce CPU work
+                            t = t.to(dtype=getattr(torch, str(np.dtype(target_dtype))), copy=False)
+                        except Exception:
+                            pass
+                    arr = t.cpu().numpy()
+                    if target_dtype is not None and arr.dtype != target_dtype:
+                        arr = arr.astype(target_dtype, copy=False)
+                    return arr
+                arr = np.asarray(x)
+                if target_dtype is not None and arr.dtype != target_dtype:
+                    arr = arr.astype(target_dtype, copy=False)
+                return arr
+            def _resample_and_uncrop(arr_c_first: np.ndarray, props: dict) -> np.ndarray:
+                """
+                arr_c_first: (C, H, W) or (C, Z, H, W); resample to size_after_cropping then uncrop to original_size_of_raw_data
+                """
+                if props is None:
+                    return arr_c_first
+                target_after_crop = props.get('size_after_cropping')
+                orig_size = props.get('original_size_of_raw_data')
+                crop_bbox = props.get('crop_bbox')
+                if target_after_crop is None or orig_size is None:
+                    return arr_c_first
+                shp = arr_c_first.shape[1:]
+                # decide separate z
+                if len(shp) == 2:
+                    do_separate_z = False
+                    lowres_axis = None
+                else:
+                    if get_do_separate_z(props.get('original_spacing')):
+                        do_separate_z = True
+                        lowres_axis = get_lowres_axis(props.get('original_spacing'))
+                    elif get_do_separate_z(props.get('spacing_after_resampling')):
+                        do_separate_z = True
+                        lowres_axis = get_lowres_axis(props.get('spacing_after_resampling'))
+                    else:
+                        do_separate_z = False
+                        lowres_axis = None
+                # resample if needed
+                if tuple(shp) != tuple(target_after_crop):
+                    res = resample_data_or_seg(arr_c_first, target_after_crop, is_seg=False,
+                                               axis=lowres_axis, order=1, do_separate_z=do_separate_z,
+                                               order_z=0)
+                else:
+                    res = arr_c_first
+                # uncrop back to original raw size
+                if crop_bbox is not None:
+                    if len(res.shape) == 3:
+                        c, h, w = res.shape
+                        out = np.zeros((c, *orig_size), dtype=res.dtype)
+                        # adjust bbox upper bounds to fit res
+                        bb = [list(b) for b in crop_bbox]
+                        bb[0][1] = min(bb[0][0] + h, orig_size[0])
+                        bb[1][1] = min(bb[1][0] + w, orig_size[1])
+                        out[:, bb[0][0]:bb[0][1], bb[1][0]:bb[1][1]] = res[:, :bb[0][1]-bb[0][0], :bb[1][1]-bb[1][0]]
+                        return out
+                    elif len(res.shape) == 4:
+                        c, z, h, w = res.shape
+                        out = np.zeros((c, *orig_size), dtype=res.dtype)
+                        bb = [list(b) for b in crop_bbox]
+                        bb[0][1] = min(bb[0][0] + z, orig_size[0])
+                        bb[1][1] = min(bb[1][0] + h, orig_size[1])
+                        bb[2][1] = min(bb[2][0] + w, orig_size[2])
+                        out[:, bb[0][0]:bb[0][1], bb[1][0]:bb[1][1], bb[2][0]:bb[2][1]] = \
+                            res[:, :bb[0][1]-bb[0][0], :bb[1][1]-bb[1][0], :bb[2][1]-bb[2][0]]
+                        return out
+                    else:
+                        return res
+                return res
+            if prelogits is not None:
+                prelogits_np = _to_numpy(prelogits, target_dtype=save_dtype)
+                prelogits_np = _resample_and_uncrop(prelogits_np, properties)
+                # store last-stage pre-softmax logits
+                to_save["logits_final"] = prelogits_np
+            if isinstance(enc_feats, dict) and len(enc_feats) > 0:
+                # 只保存 enc_stage0 和 dec_stage5，忽略其他 encoder/decoder 特征
+                if "enc_stage0" in enc_feats:
+                    v = enc_feats["enc_stage0"]
+                    v_np = _to_numpy(v, target_dtype=save_dtype)
+                    v_np = _resample_and_uncrop(v_np, properties)
+                    to_save["enc_stage0"] = v_np
+                # 保存 dec_stage5（最后一个 decoder stage）
+                if "dec_stage5" in enc_feats:
+                    v = enc_feats["dec_stage5"]
+                    v_np = _to_numpy(v, target_dtype=save_dtype)
+                    v_np = _resample_and_uncrop(v_np, properties)
+                    to_save["dec_stage5"] = v_np
+
+            # persist
+            if len(to_save) == 0:
+                print("WARNING: No features collected (prelogits/encoder). Nothing saved for", out_npz)
+                return
+            if compress:
+                np.savez_compressed(out_npz, **to_save)
+            else:
+                np.savez(out_npz, **to_save)
+            if verbose:
+                print(f"saved features to {out_npz} with keys: {list(to_save.keys())}")
+        finally:
+            # restore mode flags
+            if ds_attr_present and ds_prev is not None:
+                self.network.do_ds = ds_prev
+            self.network.train(current_mode)
